{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "JAVA_HOME": "C:\\Program Files\\Java\\jdk-21"
  },
  "permissions": {
    "allow": [
      "Bash(./mvnw:*)",
      "Bash(./tools/validate-tests.sh:*)",
      "Bash(../tools/validate-tests.sh:*)",
      "Bash(./tools/validate-integration.sh:*)",
      "PowerShell(.\\mvnw.cmd:*)",
      "PowerShell(.\\tools\\validate-tests.ps1:*)",
      "PowerShell(..\\tools\\validate-tests.ps1:*)",
      "PowerShell(.\\tools\\validate-integration.ps1:*)",
      "PowerShell(..\\tools\\validate-integration.ps1:*)",
      "Bash(./tools/validate-contracts.sh:*)",
      "Bash(../tools/validate-contracts.sh:*)",
      "PowerShell(.\\tools\\validate-contracts.ps1:*)",
      "PowerShell(..\\tools\\validate-contracts.ps1:*)",
      "Bash(newman run:*)",
      "Bash(npx --yes --registry=https://registry.npmjs.org newman:*)",
      "Bash(docker compose -f docker-compose.integration.yml:*)",
      "Bash(curl -s http://localhost:8082/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(java -version)"
