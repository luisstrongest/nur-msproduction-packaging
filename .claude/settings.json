    "deny": [
      "Edit(ms-production-packaging/src/test/resources/pacts/**)",
      "Write(ms-production-packaging/src/test/resources/pacts/**)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(./mvnw deploy:*)",
      "Bash(mvn deploy:*)",
      "Bash(docker system prune:*)",
      "Read(./**/.env)"
    ]
  }
}
