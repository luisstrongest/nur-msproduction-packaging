    "ask": [
      "Edit(ms-production-packaging/src/main/**)",
      "Write(ms-production-packaging/src/main/**)",
      "Edit(contract-testing/bc5-logistic-consumer/src/main/**)",
      "Write(contract-testing/bc5-logistic-consumer/src/main/**)",
      "Edit(**/pom.xml)",
      "Edit(docker-compose.integration.yml)"
